# ============================================================================
# Environment variables
# ============================================================================
# The CURRENT site needs none of these. As it ships today it is a fully static
# React + Vite bundle: no backend, no database, no server functions.
#
# Everything below belongs to the PLANNED Supabase + ImageKit data layer
# described in db/README.md. Copy to .env and fill in only when that work starts.
# ============================================================================


# ---------------------------------------------------------------------------
# Supabase — text rows only (titles, timings, prices, image FILE NAMES)
# ---------------------------------------------------------------------------
# The API endpoint, NOT the marketing site.
#   correct:   https://abcdefghijklmnop.supabase.co
#   incorrect: https://supabase.co     (no project ref; every request 400s)
SUPABASE_URL=

# Settings -> API -> "anon public" key.
# PUBLIC by design: it ships in the browser bundle. It is only safe while Row
# Level Security is enabled on every table — see db/migrations/0001_rituals.sql.
SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# ImageKit — the CDN that serves every ritual photo / gallery image
# ---------------------------------------------------------------------------
# The "URL endpoint" from the ImageKit dashboard, no trailing slash.
IMAGEKIT_ENDPOINT=


# ============================================================================
# Notes
# ============================================================================
# 1. NEVER put a Supabase service_role key in any VITE_* variable. Vite inlines
#    VITE_* into the public bundle, and service_role bypasses RLS entirely.
#    Server-side secrets belong in the hosting provider's secret store only.
#
# 2. When these move from the standalone prototype
#    (prototypes/supabase-rituals/config.js) into the React app, Vite only
#    exposes variables prefixed with VITE_, so the names become:
#        VITE_SUPABASE_URL
#        VITE_SUPABASE_ANON_KEY
#        VITE_IMAGEKIT_ENDPOINT
#    and are read with import.meta.env.VITE_* instead of process.env.*
#
# 3. The prototype has no build step, so it cannot read this file; it uses
#    prototypes/supabase-rituals/config.js instead.
# ============================================================================
